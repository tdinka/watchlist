# Copy this file to .env and fill in real values before running the app.

# Postgres connection string. Locally, use the public URL of the Railway
# Postgres service (Railway → Postgres → "Connect" → public URL).
DATABASE_URL=""

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The URL the app is served from. For local dev, leave as-is.
NEXTAUTH_URL="http://localhost:3000"

# Required. Free from https://www.themoviedb.org/settings/api (make a TMDB
# account, then "Create" → Developer). Either the "API Read Access Token"
# (long, starts with eyJ) or the shorter "API Key" works.
TMDB_API_KEY=""

# Which country's catalogues to show. Two-letter code.
WATCH_REGION="US"

# Optional: email alerts. Free key from https://resend.com/api-keys.
# Until a domain is verified in Resend, leave EMAIL_FROM blank and Resend
# only delivers to the address the Resend account was made with.
RESEND_API_KEY=""
EMAIL_FROM=""

# Secret the daily Railway cron job sends to /api/cron/check.
# Generate with: openssl rand -hex 24
CRON_SECRET=""
