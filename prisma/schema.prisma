// Watchlist — data model
// Titles themselves (posters, seasons, where to watch) come live from TMDB.
// The database only keeps what is ours: who is in the household, what they
// subscribe to, their favorites, and the alerts we've sent them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  // TMDB watch-provider ids of the services this household pays for.
  // Defaults: Netflix (8), HBO Max (1899), Amazon Prime Video (9), Apple TV+ (350).
  services   Int[]    @default([8, 1899, 9, 350])
  createdAt  DateTime @default(now())

  users User[]
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  // No longer used: sign-in is by a code emailed to `email`. Kept (optional)
  // because dropping a column with data in it would stop `prisma db push`.
  passwordHash       String?
  name               String
  emailAlerts        Boolean   @default(true)
  // Letterboxd username whose public activity feed the daily check reads,
  // and the time of the newest entry already brought in.
  letterboxdUser     String?
  letterboxdSyncedAt DateTime?
  createdAt          DateTime  @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  favorites  Favorite[]
  alerts     Alert[]
  dismissed  Dismissed[]
  showAlerts ShowAlertSetting[]
}

model Favorite {
  id          String   @id @default(cuid())
  tmdbId      Int
  mediaType   String // "tv" | "movie"
  title       String
  posterPath  String?
  // Which list this entry is for: "loved" (watched and liked; drives
  // recommendations) or "want" (want to watch). A title on both lists has
  // one entry for each.
  list        String   @default("loved")
  // The household's services this was streaming on at the last check, e.g.
  // "Netflix, HBO Max". "" = on none of them. Null = not checked yet.
  availableOn String?
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, mediaType, tmdbId, list])
  @@index([mediaType, tmdbId])
}

// The latest episode we've seen for each favorited show, so the daily check
// can tell when a new episode or season has come out.
model ShowState {
  tmdbId      Int      @id
  name        String
  lastSeason  Int?
  lastEpisode Int?
  lastAirDate String?
  nextSeason  Int?
  nextEpisode Int?
  nextAirDate String?
  status      String?
  // TMDB's kind of show, e.g. "Scripted", "Talk Show", "News". Talk and news
  // shows air almost daily, so by default they only alert for new seasons.
  type        String?
  checkedAt   DateTime @default(now())
}

model Alert {
  id         String    @id @default(cuid())
  // Stops the same news being sent twice, e.g. "tv:1399:s8e1".
  key        String
  kind       String // "new_season" | "new_episode" | "now_streaming" | "leaving_soon"
  // For episode alerts: how many new episodes this one alert covers. Unseen
  // episode news for a show is kept in one alert that grows, not one each.
  episodes   Int?
  tmdbId     Int
  mediaType  String
  title      String
  message    String
  posterPath String?
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  emailedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, key])
  @@index([userId, readAt])
}

// One-time sign-in codes sent by email. Only a hash of the code is stored.
// A code for someone signing up carries their sign-up details in `signup`;
// the account is only created once they enter the code, so nobody can claim
// an email address they can't read.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  signup    Json?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Titles someone marked "Not for me" so recommendations stop showing them.
model Dismissed {
  tmdbId    Int
  mediaType String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([userId, mediaType, tmdbId])
}

// Titles leaving a streaming service in the next month, from the Streaming
// Availability API's "expiring" feed (movieofthenight.com). The daily check
// refreshes it. One row per title per service.
model Leaving {
  mediaType String
  tmdbId    Int
  service   String // as the feed names it, e.g. "Netflix"
  leavesOn  String // last day to watch, e.g. "2026-11-12"
  checkedAt DateTime @default(now())

  @@id([mediaType, tmdbId, service])
  @@index([leavesOn])
}

// Small bits of app-wide state, e.g. when the leaving-soon feed last ran.
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Someone's choice of how much to hear about one show. No row = automatic:
// every episode, except talk and news shows, which get new seasons only.
model ShowAlertSetting {
  tmdbId Int
  level  String // "episodes" | "seasons" | "off"

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([userId, tmdbId])
}
